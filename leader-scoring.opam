opam-version: "2.0"
synopsis:
  "Venue-neutral leader track records, risk metrics, composite and learned scores, copyability and alerts"
description:
  "Builds an equity curve and per-trade records from a trader's fills, funding and account snapshots; computes documented performance and risk metrics; ranks a universe with a transparent weighted score and an optional gradient-boosted model; estimates follower slippage and capacity from order-book depth; and flags behaviour changes for followers."
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
tags: ["ocaml" "oxcaml" "copy-trading" "quant"]
homepage: "https://github.com/winterchill-trading/leader-scoring"
bug-reports: "https://github.com/winterchill-trading/leader-scoring/issues"
depends: [
  "ocaml" {>= "5.2"}
  "oxcaml"
  "dune" {>= "3.17"}
  "core"
  "async_kernel"
  "ppx_jane"
  "yojson"
  "market-data"
  "core_bench" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/leader-scoring.git"
